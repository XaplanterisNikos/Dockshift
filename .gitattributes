# Normalize line endings: LF in the repository, native endings on checkout
* text=auto

# Shell scripts must keep LF, or they break on Linux/macOS/CI
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf

# Binary files: never touch their bytes
*.jar binary
*.png binary
*.webp binary
*.jks binary
