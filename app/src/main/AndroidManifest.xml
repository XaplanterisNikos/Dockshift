<?xml version="1.0" encoding="utf-8"?>
<!--
    Dockshift v2 manifest.
    No storage permissions: CSV import/export will use the system file picker
    (Storage Access Framework), which needs none.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- android:name: the Hilt application class that owns the dependency container -->
    <application
        android:name=".DockshiftApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dockshift">

        <!-- Single activity: every screen is a Compose destination inside it -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dockshift.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
