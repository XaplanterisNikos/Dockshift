<?xml version="1.0" encoding="utf-8"?>
<!--
    Dockshift v2 manifest.
    No storage permissions: backups and the v1 import use MediaStore and the system
    file picker (Storage Access Framework), which need none.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reads the terminal's public vessel pages; a normal permission, never asked -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Tells "the phone is offline" from "a phone setting keeps this app off the
        internet", so the message says what to fix; also a normal permission
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- android:name: the Hilt application class that owns the dependency container -->
    <application
        android:name=".DockshiftApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dockshift">

        <!-- Single activity: every screen is a Compose destination inside it -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dockshift.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
