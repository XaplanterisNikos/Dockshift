# Template for release signing.
# Copy this file to `keystore.properties` (same folder) and fill in the real values.
# `keystore.properties` is git-ignored: it must NEVER be committed.
#
# Use forward slashes in the path (C:/Users/...). In .properties files a single
# backslash is an escape character, so C:\Users\... would be read incorrectly.
storeFile=C:/Users/YOUR_USER/keys/your-release-key.jks
storePassword=CHANGE_ME
keyAlias=your_key_alias
keyPassword=CHANGE_ME
